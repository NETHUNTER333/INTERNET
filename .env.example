# Supabase Configuration (Optional - app will use local storage if not provided)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Alberto AI Research Assistant (Optional - for LLM completion and OpenRouter)
ALBERTO_API_KEY=
ALBERTO_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=

# Deep Reading & Scraping (Optional - Firecrawl or TinyFish)
FIRECRAWL_API_KEY=
TINYFISH_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development
